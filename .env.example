# Connect as a user scoped to readWrite on this one database only — not a
# MongoDB admin/root account (the app never needs more than CRUD on its own
# collections). MONGODB_DB is read explicitly by the app (not parsed out of
# the URI), since mongodb+srv:// URIs (Atlas) don't carry a database name.
#
# Local/self-hosted: provision the scoped user once with
# scripts/create-db-user.mjs run against an admin connection. Self-hosted
# users are created inside a specific database, so authSource must match it:
MONGODB_URI=mongodb://boardly_app:changeme@127.0.0.1:27017/?authSource=app&retryWrites=false
MONGODB_DB=app
#
# Atlas (production): create the user via Atlas's Database Access UI with a
# role scoped to just this database (e.g. "readWrite@app"), not a built-in
# admin role. Atlas always stores its users in its own admin database, so
# omit authSource (it defaults to admin) — the readWrite grant, not
# authSource, is what limits the user to this one database:
# MONGODB_URI=mongodb+srv://boardly_app:changeme@cluster0.z3jwk.mongodb.net/?appName=Cluster0
# MONGODB_DB=app

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Social providers (leave blank to disable a provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
